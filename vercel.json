{
  "version": 2,
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.davidcastillodev.com/api/$1"
    },
    {
      "src": "^/(.*\\.(?:js|mjs|css|map|png|jpg|jpeg|svg|ico|webp|ttf|woff2?))$",
      "dest": "/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
