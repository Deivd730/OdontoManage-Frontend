{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/static-build", "config": { "distDir": "dist/OdontoManage", "buildCommand": "npm run build" } }
  ],
  "routes": [
    {
      "src": "^/api/(.*)$",
      "dest": "https://api.davidcastillodev.com/api/$1"
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html"
    }
  ]
}
